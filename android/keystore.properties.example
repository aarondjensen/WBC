# ══════════════════════════════════════════════════════════════════
#  Release signing — copy to keystore.properties and fill in
# ══════════════════════════════════════════════════════════════════
#
# Copy this file to `android/keystore.properties` and put the real values in
# it. That file is gitignored, and so are *.jks / *.keystore — the upload key
# is the one credential in this project that cannot be rotated casually. Lose
# control of it and every future update to the app has to come from whoever
# holds it. It belongs in a password manager, with a backup somewhere that is
# not this laptop.
#
# app/build.gradle reads these four keys. The same four can come from the
# environment instead — WBC_KEYSTORE_FILE, WBC_KEYSTORE_PASSWORD,
# WBC_KEY_ALIAS, WBC_KEY_PASSWORD — for a CI runner that holds secrets but no
# file. The environment wins where both are set.
#
# With this in place:
#
#   npm run android:bundle
#   # → android/app/build/outputs/bundle/release/app-release.aab
#
# (That wraps build + sync + gradle. Don't write the three out by hand here:
# `&&` is not a statement separator in PowerShell and `./gradlew` is not
# runnable on Windows, which is where this file gets read.)
#
# Bump versionCode in app/build.gradle before every upload: Play refuses any
# bundle whose versionCode is not strictly higher than the last one it took.
#
# Making a key, if there isn't one yet (once, ever — keep it forever):
#
#   keytool -genkey -v -keystore android/upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# If Play App Signing is already enrolled for com.wannabecup.app, this is the
# UPLOAD key, not the app signing key — Google holds that one, and a lost
# upload key can be reset from the console. If it is not enrolled, this key IS
# the app signing key and there is no reset.

# Absolute, or relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
