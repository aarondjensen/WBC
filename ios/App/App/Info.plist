<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>WBC</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.281900029443-h6fiklei6h681ssrl240mlq0o9lelqvv</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance, answered once here instead of once per upload.
	     WBC's only encryption is HTTPS to Firebase and the platform's own
	     keychain — both exempt under category 5 part 2 — so the honest answer
	     is "no non-exempt encryption". Without this key App Store Connect
	     stops every single build at a manual questionnaire before it will let
	     TestFlight or review see it. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos from your library to add to the tournament gallery.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take photos during the tournament to add to the shared gallery.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- arm64, not the armv7 Capacitor's template still ships. armv7 is 32-bit
	     hardware that stopped being supported at iOS 11; declaring it as a
	     REQUIRED capability on an iOS 15 minimum is a requirement no device
	     that can install this app actually meets, and it is the sort of thing
	     that surfaces as an unexplained "compatible with 0 devices" on the
	     App Store listing rather than as a build error. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- WBC is a dark app (bg #080f1e). Without this, iOS renders the status bar
	     clock/battery in DARK text, which is unreadable on the dark header.
	     Capacitor's CAPBridgeViewController reads this key and applies
	     .lightContent (white text). -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
</dict>
</plist>
