rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  Cloud Storage security rules — WBC
// ══════════════════════════════════════════════════════════════════
//
// This bucket holds ONE thing: photos from the tournament currently being
// played. It is not the photo library. The library is seventeen years deep and
// lives on Cloudflare Pages, one project per edition — see src/lib/media.js.
// At the end of an edition its photos are deployed to that project and this
// bucket is emptied, which is what keeps it permanently inside the no-cost
// tier instead of eventually outgrowing it.
//
// ── Read this before widening anything ────────────────────────────
// These rules CANNOT do what firestore.rules does, and the difference is not
// an oversight.
//
// Every write in firestore.rules requires MEMBERSHIP: a wbc_accounts/{uid}
// document, obtained by presenting the tournament password. That check is an
// `exists()` against Firestore. Storage rules have no equivalent — there is no
// way to read Firestore, or anything else, from this file. The only facts
// available here are the caller's auth token and the properties of the object
// being written.
//
// So the strongest gate this bucket can have is: signed in, small, an image.
// A stranger with a Google account and the app's public config — which ships
// in the bundle by design — can write objects here. What they CANNOT do is
// make one appear in the app: a photo exists in WBC because a wbc_media
// document points at it, and creating that document requires membership. An
// unreferenced object is invisible, capped at 2MB, and removable by a
// director emptying the bucket.
//
// That is the accepted trade for a sixteen-person tournament. If it ever needs
// to be closed properly, the fix is not a cleverer rule here — it is routing
// uploads through a Cloud Function that checks membership and hands back a
// signed URL, at the cost of an invocation per photo.
//
// ── The size cap is the cost control ──────────────────────────────
// 2MB is generous for what the client actually sends. src/lib/mediaUpload.js
// downscales every photo to a 1600px WebP (~250KB) and a 400px thumbnail
// (~25KB) before uploading, so a legitimate write is a tenth of the cap. The
// cap exists to bound what an unauthenticated-in-spirit writer can cost, not
// to constrain the app.
//
// Deploy: `firebase deploy --only storage` from the repo root.

service firebase.storage {
  match /b/{bucket}/o {

    // What the client is downscaled to. Kept as one place so the cap and the
    // comment above it cannot drift apart.
    function withinSize() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── The live edition's photos ─────────────────────────────────
    // Keyed by edition slug — editions/2026/{id}.webp and {id}_thumb.webp —
    // so graduating a year to its Pages project is a prefix listing rather
    // than a query, and emptying it afterwards is a prefix delete.
    //
    // Read is open. The URLs are unguessable download URLs handed out by the
    // SDK, and the gallery that shows them is open to a guest anyway.
    match /editions/{edition}/{file} {
      allow read: if true;
      allow create: if isSignedIn() && withinSize() && isImage();
      // No update: a photo id is generated per upload and bytes are never
      // rewritten in place, which is also what makes the year-long immutable
      // Cache-Control header on them safe.
      allow update: if false;
      // Deleting bytes is paired with deleting the wbc_media document, and
      // that document is what firestore.rules actually guards. A signed-in
      // caller can only delete here; they cannot make the photo disappear
      // from the app without also passing the membership check over there.
      allow delete: if isSignedIn();
    }

    // ── Everything else ───────────────────────────────────────────
    // Default deny. Adding a prefix to the app means adding it here.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
